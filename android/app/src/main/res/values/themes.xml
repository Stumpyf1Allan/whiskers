<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar: the page draws everything. The window colour matches the page's
         background so nothing flashes while Whiskers starts. -->
    <style name="Theme.Whiskers" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
