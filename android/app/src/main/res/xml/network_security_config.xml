<?xml version="1.0" encoding="utf-8"?>
<!-- The page comes from Whiskers' own server inside the app, on the phone's loopback
     address, over plain http. Android refuses plain http unless told otherwise; this allows
     it for that address alone. Everything that leaves the phone is https. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
